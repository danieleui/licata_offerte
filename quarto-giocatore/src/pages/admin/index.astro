---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { createSupabaseServerClient } from '../../lib/supabase/server';
import {
  classeBadgeStatoPartita,
  formattaData,
  formattaOra,
  LABEL_STATO_PARTITA,
} from '../../lib/domain/formatters';

const supabase = createSupabaseServerClient(Astro.cookies, Astro.request);

const [{ data: partiteAttive }, { count: messaggiNonLetti }] = await Promise.all([
  supabase
    .from('matches')
    .select('*')
    .not('stato', 'in', '(annullata,conclusa)')
    .order('data', { ascending: true })
    .order('ora_inizio', { ascending: true }),
  supabase.from('player_messages').select('*', { count: 'exact', head: true }).is('letto_at', null),
]);
---

<AdminLayout titolo="Dashboard">
  <h1>Ciao 👋</h1>
  {messaggiNonLetti !== null && messaggiNonLetti > 0 && (
    <p class="scheda">
      Hai <strong>{messaggiNonLetti}</strong> messaggi privati non letti. Aprili dalla pagina della partita corrispondente.
    </p>
  )}

  <h2>Partite attive</h2>
  {(partiteAttive ?? []).length === 0 && (
    <p class="testo-muto">
      Nessuna partita attiva. <a href="/admin/partite/nuova">Creane una</a>.
    </p>
  )}
  {(partiteAttive ?? []).map((p) => (
    <a href={`/admin/partite/${p.id}`} class="scheda" style="display:block; text-decoration:none; color:inherit;">
      <span class={`badge ${classeBadgeStatoPartita(p.stato)}`}>{LABEL_STATO_PARTITA[p.stato]}</span>
      <p style="margin: 0.5rem 0 0; font-weight:600;">
        {formattaData(p.data)} · {formattaOra(p.ora_inizio)}–{formattaOra(p.ora_fine)}
      </p>
      <p class="testo-muto" style="margin: 0.25rem 0 0;">{p.circolo}</p>
    </a>
  ))}
</AdminLayout>
