---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PlayerForm from '../../../components/admin/PlayerForm';
import { createSupabaseServerClient } from '../../../lib/supabase/server';

const { id } = Astro.params;
const supabase = createSupabaseServerClient(Astro.cookies, Astro.request);
const { data: giocatore } = await supabase.from('players').select('*').eq('id', id ?? '').maybeSingle();

if (!giocatore) {
  return Astro.redirect('/admin/giocatori');
}
---

<AdminLayout titolo={`${giocatore.nome} ${giocatore.cognome}`}>
  <h1>Modifica giocatore</h1>
  <PlayerForm giocatore={giocatore} client:load />
</AdminLayout>
