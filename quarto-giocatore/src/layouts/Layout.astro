---
import '../styles/global.css';

interface Props {
  titolo: string;
}

const { titolo } = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{titolo} · Quarto Giocatore</title>
  </head>
  <body>
    <slot />
  </body>
</html>
